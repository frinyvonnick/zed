{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/zed-agent-hooks/0.1/schemas/model-message.schema.json",
  "title": "Model request message",
  "description": "A message of a model request, in a provider-neutral form built by Zed from LanguageModelRequestMessage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "content"
  ],
  "properties": {
    "role": {
      "type": "string",
      "description": "Author of the message.",
      "enum": [
        "system",
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "array",
      "description": "Ordered parts of the message.",
      "items": {
        "type": "object",
        "$ref": "#/$defs/Part"
      }
    }
  },
  "$defs": {
    "Part": {
      "type": "object",
      "description": "One part of a message, discriminated by `type`.",
      "oneOf": [
        {
          "type": "object",
          "description": "Plain text.",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Part kind.",
              "const": "text"
            },
            "text": {
              "type": "string",
              "description": "The text."
            }
          }
        },
        {
          "type": "object",
          "description": "Visible reasoning.",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Part kind.",
              "const": "thinking"
            },
            "text": {
              "type": "string",
              "description": "The reasoning text."
            }
          }
        },
        {
          "type": "object",
          "description": "Encrypted reasoning, content not exposed to hooks.",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Part kind.",
              "const": "redacted_thinking"
            }
          }
        },
        {
          "type": "object",
          "description": "An image; the bytes are not sent to hooks.",
          "additionalProperties": false,
          "required": [
            "type",
            "byte_length"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Part kind.",
              "const": "image"
            },
            "byte_length": {
              "type": "integer",
              "description": "Size of the encoded image in bytes.",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "description": "A tool call made by the model.",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "input"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Part kind.",
              "const": "tool_use"
            },
            "id": {
              "type": "string",
              "description": "Tool call id.",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "description": "Zed tool name.",
              "minLength": 1
            },
            "input": {
              "type": "object",
              "additionalProperties": true,
              "description": "Arguments as sent by the model. Open: the shape depends on the tool (see tool-inputs.schema.json)."
            }
          }
        },
        {
          "type": "object",
          "description": "The result of a tool call.",
          "additionalProperties": false,
          "required": [
            "type",
            "tool_use_id",
            "tool_name",
            "is_error",
            "text"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Part kind.",
              "const": "tool_result"
            },
            "tool_use_id": {
              "type": "string",
              "description": "Id of the matching tool call.",
              "minLength": 1
            },
            "tool_name": {
              "type": "string",
              "description": "Zed tool name.",
              "minLength": 1
            },
            "is_error": {
              "type": "boolean",
              "description": "True when the tool failed."
            },
            "text": {
              "type": "string",
              "description": "Text content of the result (image results are reduced to an empty string)."
            }
          }
        }
      ]
    },
    "Usage": {
      "type": "object",
      "description": "Token usage reported by the provider (Zed TokenUsage).",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "description": "Prompt tokens.",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "description": "Generated tokens.",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "description": "Prompt tokens written to the provider cache.",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "description": "Prompt tokens read from the provider cache.",
          "minimum": 0
        }
      }
    },
    "Model": {
      "type": "object",
      "description": "Model targeted by the request.",
      "additionalProperties": false,
      "required": [
        "provider",
        "id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "description": "Zed provider id (for example `openai_compatible`).",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "description": "Model id as configured in Zed.",
          "minLength": 1
        }
      }
    },
    "ToolResponse": {
      "type": "object",
      "description": "What the model receives as a tool result.",
      "additionalProperties": false,
      "required": [
        "is_error",
        "content"
      ],
      "properties": {
        "is_error": {
          "type": "boolean",
          "description": "True when the tool failed."
        },
        "content": {
          "type": "array",
          "description": "Result parts.",
          "items": {
            "type": "object",
            "description": "Text or image part.",
            "oneOf": [
              {
                "type": "object",
                "description": "Text result.",
                "additionalProperties": false,
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Part kind.",
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "description": "The text."
                  }
                }
              },
              {
                "type": "object",
                "description": "Image result; bytes not sent.",
                "additionalProperties": false,
                "required": [
                  "type",
                  "byte_length"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Part kind.",
                    "const": "image"
                  },
                  "byte_length": {
                    "type": "integer",
                    "description": "Size in bytes.",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
